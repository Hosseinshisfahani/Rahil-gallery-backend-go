# Offline-friendly build: run `go mod vendor` on the host first, then:
#   docker compose -f docker-compose.yml -f docker-compose.vendor.yml build api
FROM golang:1.22-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor

ENV GOFLAGS=-mod=vendor
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app
COPY --from=builder /out/api .

EXPOSE 8080

USER nobody

ENTRYPOINT ["/app/api"]
