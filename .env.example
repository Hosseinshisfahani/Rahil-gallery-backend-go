# Rahil Gallery Server Environment Variables
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8081

# PostgreSQL Configuration
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/rahil_gallery?sslmode=disable

# JWT Configuration
JWT_ACCESS_SECRET=08df5dd6f451388ee71e8ac9f3d95b85
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Go Proxy Configuration
GOPROXY=https://goproxy.io,https://goproxy.cn,direct

# Kavenegar SMS
# Set KAVENEGAR_ENABLED=true only when ready for real sends.
# KAVENEGAR_SENDER (or SMS_SENDER_ID) must be a line authorized for this API key.
# Kavenegar status 427 = "line requires access level" — grant the line to the API key
# in the Kavenegar panel (or switch to an authorized sender) before live bulk QA.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
SMS_SENDER_ID=
KAVENEGAR_BIRTHDAY_TEMPLATE=birthday
KAVENEGAR_ENABLED=false
SMS_BIRTHDAY_CRON="0 9 * * *"
SMS_BIRTHDAY_TZ=Asia/Tehran
SMS_BULK_BATCH_SIZE=200
SMS_BULK_MAX_CONCURRENCY=3
