APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Local API + Docker Postgres (make docker-dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rahil_gallery?sslmode=disable

# API running inside Docker Compose uses host `db` instead of localhost
# DATABASE_URL=postgres://postgres:postgres@db:5432/rahil_gallery?sslmode=disable

# Catalog seed images (make fetch-catalog-images)
# CATALOG_ASSETS_DIR=data/catalog-images
# Customer signature uploads (writable; created on first upload)
# CUSTOMER_SIGNATURES_DIR=data/customer-signatures
# SEED_ASSET_BASE_URL=http://localhost:8080

# Observability — error retention in Postgres + Prometheus /metrics
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_INGEST_KEY=change-me-for-client-error-ingest
# OBSERVABILITY_RETENTION_DAYS=7
# METRICS_ENABLED=true
# METRICS_SERVICE_NAME=rahil_api
# GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_PORT=3001

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Docker Hub blocked on server? Use a registry mirror in /etc/docker/daemon.json, or override images:
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
# MIGRATE_IMAGE=docker.arvancloud.ir/migrate/migrate:v4.18.1
# Or load images locally: docker save ... | scp ... | docker load

# Go modules — proxy.golang.org is blocked on many VPS networks (TLS timeout):
GOPROXY=https://goproxy.io,https://goproxy.cn,direct
# If still blocked: build binary on your laptop (bash scripts/bundle-api-binary.sh) and SCP to VPS.
