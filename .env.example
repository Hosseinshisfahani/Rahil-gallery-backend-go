APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8081

# Local API + Docker Postgres (make docker-dev)
# Default port 5433 avoids clashing with other Postgres instances on :5432.
# Default port 8081 avoids clashing with other APIs on :8080.
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/rahil_gallery?sslmode=disable

# Production database settings:
# - DATABASE_URL is the source of truth for API/migration credentials.
# - CI/CD derives POSTGRES_PASSWORD and DATABASE_URL_DOCKER from DATABASE_URL.
# - Do not set DATABASE_URL_DOCKER in .env unless DATABASE_URL is intentionally absent.
# - Postgres is bound to localhost by default; set POSTGRES_BIND_ADDRESS=0.0.0.0 only for a trusted private network.
# POSTGRES_USER=postgres
# POSTGRES_DB=rahil_gallery
# POSTGRES_PORT=5432
# POSTGRES_BIND_ADDRESS=127.0.0.1

# Optional — normally derived from DATABASE_URL by deploy-remote.sh (do not set unless you know the password matches Postgres).
# DATABASE_URL_DOCKER=postgres://postgres:postgres@db:5432/rahil_gallery?sslmode=disable

# API running inside Docker Compose uses host `db` instead of localhost
# DATABASE_URL=postgres://postgres:postgres@db:5432/rahil_gallery?sslmode=disable

# Catalog seed images (make fetch-catalog-images)
# CATALOG_ASSETS_DIR=data/catalog-images
# Customer signature uploads (writable; created on first upload)
# CUSTOMER_SIGNATURES_DIR=data/customer-signatures
# SEED_ASSET_BASE_URL=http://localhost:8080

# Observability — error retention in Postgres + Prometheus /metrics
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_INGEST_KEY=change-me-for-client-error-ingest
# OBSERVABILITY_RETENTION_DAYS=7
# METRICS_ENABLED=true
# METRICS_SERVICE_NAME=rahil_api
# GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_PORT=3001

JWT_ACCESS_SECRET=08df5dd6f451388ee71e8ac9f3d95b85
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Production bootstrap (make seed-prod) — first admin account after migrate
# SEED_ADMIN_EMAIL=admin@rehil.gallery
# SEED_ADMIN_PASSWORD=change-me-min-8-chars-with-letter-and-digit
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Rehil
# SEED_ADMIN_PHONE=+989101000001
# Optional staff account (both email and password required):
# SEED_STAFF_EMAIL=staff@rehil.gallery
# SEED_STAFF_PASSWORD=change-me-min-8-chars-with-letter-and-digit

# Docker Hub blocked on server? Use a registry mirror in /etc/docker/daemon.json, or override images:
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
# MIGRATE_IMAGE=docker.arvancloud.ir/migrate/migrate:v4.18.1
# Or load images locally: docker save ... | scp ... | docker load

# Go modules — proxy.golang.org is blocked on many VPS networks (TLS timeout):
GOPROXY=https://goproxy.io,https://goproxy.cn,direct
# If still blocked: build binary on your laptop (bash scripts/bundle-api-binary.sh) and SCP to VPS.
